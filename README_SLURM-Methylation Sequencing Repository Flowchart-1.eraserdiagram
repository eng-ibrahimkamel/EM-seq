// Main pipeline nodes
MainPipeline [color: lightblue] {
  Start Main Pipeline [shape: oval]
  Check Genome File [shape: diamond]
  Index Reference [shape: rectangle]
  Detect Libraries [shape: rectangle]
  Check Library Read Count [shape: diamond]
  Notify Low Read Libraries [shape: oval]
  Library Ready [shape: oval]
  Align Reads [shape: rectangle]
  Mark Duplicates [shape: rectangle]
  Extract Methylation Data [shape: rectangle]
  Compute Summary Statistics [shape: rectangle]
  Aggregation Decision [shape: diamond]
  Run Aggregation [shape: rectangle]
  Generate Final Report [shape: oval]
  End Main Pipeline [shape: oval]
}

// Legacy EM-seq pipeline nodes
LegacyPipeline [color: lightgreen] {
  Start Legacy Pipeline [shape: oval]
  Detect FASTQ Pairs [shape: rectangle]
  Run Mapping [shape: rectangle]
  Merge and Deduplicate [shape: rectangle]
  Bias Analysis [shape: rectangle]
  Extract Methylation [shape: rectangle]
  LegacyStats [shape: rectangle]
  Legacy MultiQC [shape: oval]
  Combine Mbias Tables [shape: rectangle]
  Combine Mbias PDF [shape: rectangle]
  End Legacy Pipeline [shape: oval]
}

// Detail of legacy pipeline statistics steps
LegacyStats [color: yellow] {
  Select Human Reads
  Run FastQC
  Summarize Nonconverted Reads
  Combine Nonconverted Results
  Generate Flagstats
  Generate Basic Alignment Stats
  Collect GC Bias Metrics
  Collect Picard Metrics
  Compute Insert Size Metrics
  Compute Human GC Bias
  Compute Human Insert Size
  Calculate Coverage Statistics
}

