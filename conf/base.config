// Dynamic resource fetching
def availableCpus = { java.lang.Runtime.getRuntime().availableProcessors() }()
def availableMemoryGB = {
    def osBean = java.lang.management.ManagementFactory.getOperatingSystemMXBean() as com.sun.management.OperatingSystemMXBean
    def totalMemoryGB = (osBean.getTotalPhysicalMemorySize() / (1024 * 1024 * 1024)) as float
    return Math.max(totalMemoryGB * 0.3, 1) // Reserve memory for OS
}()

// Define check_max function for resource limits
def check_max(obj = null, type = null) {
    // Handle case where function is called with no arguments
    if (obj == null || type == null) {
        println "WARNING: check_max() called with missing arguments. Using default values."
        return 1
    }

    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "WARNING: Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "WARNING: Max time '${params.max_time}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "WARNING: Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}

process {
    // Executor is now defined in profiles (nextflow.config)
    cpus   = { check_max( Math.min(1, Math.max(1, (availableCpus as Integer))) * task.attempt, 'cpus'   ) }
    memory = { check_max( Math.min(6, Math.max(2, (availableMemoryGB as Integer))) * task.attempt, 'memory' ) }
    time   = { check_max( 4.h  * task.attempt, 'time'   ) }

    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // See https://www.nextflow.io/docs/latest/config.html#config-process-selectors

    withLabel: cpus_8 {
        cpus   = { Math.min(8, Math.max(2, (availableCpus as Integer))) }
        memory = { "${Math.min(64, Math.max(16, (availableMemoryGB * 2 as Integer)))} GB" }
        errorStrategy = 'retry'
    }

    withLabel: cpus_2 {
        cpus   = { Math.min(2, Math.max(1, (availableCpus as Integer))) }
        memory = { "${Math.min(6, Math.max(2, (availableMemoryGB as Integer)))} GB" }
        errorStrategy = 'retry'
    }

    withLabel: process_low {
        cpus   = { check_max( Math.min(2, Math.max(1, (availableCpus as Integer))) * task.attempt, 'cpus'    ) }
        memory = { check_max( Math.min(12, Math.max(4, (availableMemoryGB as Integer))) * task.attempt, 'memory'  ) }
        time   = { check_max( 4.h   * task.attempt, 'time'    ) }
    }

    withLabel: high_cpu {
        cpus = { Math.min(task.requested_cpus ?: 16, availableCpus) }
        memory = { "${Math.min(64, Math.max(7, (availableMemoryGB as Integer)))} GB" }
    }

    withLabel: medium_cpu {
        cpus = { Math.min(task.requested_cpus ?: 4, availableCpus) }
        memory = { "${Math.min(8, Math.max(4, (availableMemoryGB as Integer)))} GB" }
    }

    withLabel: low_cpu {
        cpus = 1
        memory = '4 GB' 
    }
}
