// === Dynamic resource fetching (calculated at runtime) ===
def availableCpus = { java.lang.Runtime.getRuntime().availableProcessors() }()

def availableMemoryGB = {
    def osBean = java.lang.management.ManagementFactory.getOperatingSystemMXBean() as com.sun.management.OperatingSystemMXBean
    def totalMemoryGB = (osBean.getTotalPhysicalMemorySize() / (1024 * 1024 * 1024)) as float
    return Math.max(totalMemoryGB * 0.3, 1) // Reserve memory for OS
}()

// === Utility function to cap resources at user-defined maximums ===
def check_max(obj = null, type = null) {
    if (obj == null || type == null) {
        println "WARNING: check_max() called with missing arguments. Using default values."
        return 1
    }

    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "WARNING: Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "WARNING: Max time '${params.max_time}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "WARNING: Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}

// === Environment and reporting setup ===
conda.enabled = true
conda.useMicromamba = false
conda.channels = ['conda-forge', 'bioconda', 'defaults']

report.enabled = true
report.overwrite = true
timeline.enabled = true
timeline.overwrite = true
dag.enabled = true
dag.overwrite = true

// === Global resource constraints (can be tuned based on SLURM limits) ===
// Ask SLURM admin about real limits per job or partition
params.max_memory = 128.GB  // ✅ CONFIGURABLE, ASK ADMIN to match allowed max per job
params.max_cpus = 16        // ✅ CONFIGURABLE, ASK ADMIN about CPU per job/user
params.max_time = 240.h     // ✅ CONFIGURABLE, ASK ADMIN about max runtime per job

// === Custom pipeline parameters ===
params.path_to_ngs_agg = ""
params.revision = ""
params.lane = "default"
params.sample = "default"

// === Profiles ===
profiles {
  // Local execution profile (default)
  standard {
    process.executor = 'local'
  }

  // SLURM profile (used in HPC clusters)
  slurm {
    process.executor = 'slurm'

    // ⚠️ ASK ADMIN: which SLURM partition/queue should I use?
    process.queue = 'normal'

    // ⚠️ ASK ADMIN: what SLURM account or QoS is required?
    process.clusterOptions = '--account=your_account'

    // ⚠️ MATCH these with what SLURM allows per node/partition
    params.max_memory = 900.MB   // 🧑‍💼 ASK ADMIN about per-job memory limit
    params.max_cpus = 2          // 🧑‍💼 ASK ADMIN about max CPUs per job
    params.max_time = 72.h       // 🧑‍💼 ASK ADMIN about wall time limit

    executor.queueSize = 100     // Avoid overloading scheduler

    process.memory = {
      def mem = 500.MB * task.attempt
      return check_max(mem, 'memory')
    }

    process.time = {
      def t = 4.h * task.attempt
      return check_max(t, 'time')
    }

    process.cpus = {
      def c = 1 * task.attempt
      return check_max(c, 'cpus')
    }
  }
}

// === Default process block (applies to all jobs) ===
process {
  cpus = {
    check_max(Math.max(1, Math.min(availableCpus as Integer, 2)) * task.attempt, 'cpus')
  }

  memory = {
    check_max(Math.max(400, Math.min((availableMemoryGB * 400 as Integer), 800)) * task.attempt, 'memory')
  }

  time = {
    check_max(4.h * task.attempt, 'time')
  }

  errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
  maxRetries    = 1
  maxErrors     = '-1'

  // === Labels for specific tasks ===
  withLabel: cpus_8 {
    cpus = { Math.min(Math.max(1, Math.min((availableCpus as Integer), 8)), params.max_cpus as int) }
    memory = { "${Math.max(400, Math.min((availableMemoryGB * 400 as Integer), 800))} MB" }
    errorStrategy = 'retry'
  }

  withLabel: cpus_2 {
    cpus = { Math.min(Math.max(1, Math.min((availableCpus as Integer), 2)), params.max_cpus as int) }
    memory = { "${Math.max(400, Math.min((availableMemoryGB * 400 as Integer), 800))} MB" }
    errorStrategy = 'retry'
  }

  withLabel: process_low {
    cpus = { check_max(Math.max(1, Math.min((availableCpus as Integer), 2)) * task.attempt, 'cpus') }
    memory = { check_max(Math.max(400, Math.min((availableMemoryGB * 400 as Integer), 800)) * task.attempt, 'memory') }
    time = { check_max(4.h * task.attempt, 'time') }
  }

  withLabel: high_cpu {
    cpus = { Math.min(Math.min(task.requested_cpus ?: 1, availableCpus), params.max_cpus as int) }
    memory = { "${Math.max(400, Math.min((availableMemoryGB * 400 as Integer), 800))} MB" }
  }

  withLabel: medium_cpu {
    cpus = { Math.min(Math.min(task.requested_cpus ?: 1, availableCpus), params.max_cpus as int) }
    memory = { "${Math.max(400, Math.min((availableMemoryGB * 300 as Integer), 600))} MB" }
  }

  withLabel: low_cpu {
    cpus = 1
    memory = '400 MB'
  }
}
