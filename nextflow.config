// === Dynamic resource fetching (calculated at runtime) ===
def availableCpus = { java.lang.Runtime.getRuntime().availableProcessors() }()

def availableMemoryGB = {
    def osBean = java.lang.management.ManagementFactory.getOperatingSystemMXBean() as com.sun.management.OperatingSystemMXBean
    def totalMemoryGB = (osBean.getTotalPhysicalMemorySize() / (1024 * 1024 * 1024)) as float
    return Math.max(totalMemoryGB * 0.3, 1) // Reserve memory for OS
}()

// === Utility function to cap resources at user-defined maximums ===
def check_max(obj = null, type = null) {
    if (obj == null || type == null) {
        println "WARNING: check_max() called with missing arguments. Using default values."
        return 1
    }

    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "WARNING: Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "WARNING: Max time '${params.max_time}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "WARNING: Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}

// === Environment and reporting setup ===
conda.enabled = true
conda.useMicromamba = false
conda.channels = ['conda-forge', 'bioconda', 'defaults']

report.enabled = true
report.overwrite = true
timeline.enabled = true
timeline.overwrite = true
dag.enabled = true
dag.overwrite = true

// === Performance optimization settings ===
// Enable process-level caching to avoid redundant computations
process.cache = 'lenient'
// Enable compression for work directory to reduce disk I/O
process.compress = true
// Increase queue size to allow more parallel processes
executor.queueSize = 100

// === Global resource constraints (production values) ===
// These values are set for production environment
params.max_memory = 13.GB   // Production value for maximum memory per job
params.max_cpus = 32        // Production value for maximum CPUs per job
params.max_time = 168.h     // Production value for maximum runtime (7 days)

// === Custom pipeline parameters ===
params.path_to_ngs_agg = ""
params.revision = ""
params.lane = "default"
params.sample = "default"

// === Profiles ===
profiles {
  // Local execution profile (default)
  standard {
    process.executor = 'local'
  }



  // SLURM profile for production environment (optimized resources)
  slurm {
    process.executor = 'slurm'

    // Production SLURM partition
    process.queue = 'batch'

    // Enable job packing for better resource utilization
    process.clusterOptions = "--ntasks-per-node=1 --mem-per-cpu=4G --cpus-per-task=${task.cpus}"

    // Production resource limits
    params.max_memory = 64.GB    // Production memory limit per job
    params.max_cpus = 24         // Production CPU limit
    params.max_time = 120.h      // Production wall time limit (5 days)

    // Increase queue size and submit rate for better throughput
    executor.queueSize = 300     // Increased queue size for production
    executor.submitRateLimit = '10 sec' // Limit submission rate to avoid overwhelming scheduler

    // Enable job polling for more responsive job management
    executor.pollInterval = '30 sec'
    executor.queueStatInterval = '5 min'

    // Enable job batching to reduce scheduler overhead
    executor.jobName = { "em_seq_${task.hash}" }
    executor.perJobMemLimit = true  // Use per-job memory limits for more accurate resource allocation

    // Enable SLURM task distribution for better parallelization
    executor.queueStatInterval = '1 min'  // More frequent queue status checks
    executor.perTaskReserve = true  // Reserve resources per task for better utilization

    process.memory = {
      // Production-ready memory settings
      def mem = 4.GB * task.attempt
      return check_max(mem, 'memory')
    }

    process.time = {
      // Production-ready time settings
      def t = 12.h * task.attempt
      return check_max(t, 'time')
    }

    process.cpus = {
      // Production-ready CPU settings - more aggressive scaling
      def c = Math.min(12, params.max_cpus / 2 as Integer) * task.attempt
      return check_max(c, 'cpus')
    }

    // Increase retries for production environment
    process.maxRetries = 3
  }
}

// === Default process block (applies to all jobs) ===
process {
  cpus = {
    // First check if we're in SLURM mode
    def slurm_profile = workflow.profile.contains('slurm')
    // If in SLURM mode, use the max_cpus parameter (configurable for different environments)
    def max_cpus = slurm_profile ? params.max_cpus : 4

    check_max(Math.max(1, Math.min(availableCpus as Integer, max_cpus)) * task.attempt, 'cpus')
  }

  memory = {
    // Adjust memory based on profile
    def slurm_profile = workflow.profile.contains('slurm')
    def mem_multiplier = slurm_profile ? 600 : 400
    def mem_max = slurm_profile ? 2000 : 800
    def min_memory = slurm_profile ? 800.MB : 400.MB

    check_max(
      Math.max(min_memory.toMega().doubleValue(), Math.min((availableMemoryGB * mem_multiplier as Integer), mem_max).doubleValue()).MB * task.attempt,
      'memory'
    )
  }

  time = {
    // Longer default time for production
    def slurm_profile = workflow.profile.contains('slurm')
    def default_time = slurm_profile ? 12.h : 4.h

    check_max(default_time * task.attempt, 'time')
  }

  // Production-ready error handling
  errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
  maxRetries    = 2  // Increased for production
  maxErrors     = '-1'

  // Production-ready resource handling
  queueSize = 100  // Limit concurrent tasks to avoid overwhelming the system

  // === Labels for specific tasks with consistent resource management ===

  // For processes that need 8 CPUs (adjusts based on SLURM configuration)
  withLabel: 'cpus_8' {
    // RECOMMENDED: Use check_max for global constraints and Math.min/Math.max for local constraints
    cpus = { 
      // First check if we're in SLURM mode
      def slurm_profile = workflow.profile.contains('slurm')
      // If in SLURM mode, use the max_cpus parameter (configurable for different environments)
      def max_cpus = slurm_profile ? Math.min(16, params.max_cpus / 2 as Integer) : 8

      check_max(
        Math.min(max_cpus, Math.max(1, availableCpus as Integer)),
        'cpus'
      ) 
    }

    // Add SLURM-specific cluster options when running with SLURM profile
    clusterOptions = {
      def slurm_profile = workflow.profile.contains('slurm')
      if (slurm_profile) {
        return '--ntasks-per-node=3 --cpus-per-task=8 --hint=nomultithread'
      } else {
        return ''
      }
    }

    // RECOMMENDED: Use check_max for memory to respect global constraints
    memory = { 
      // Adjust memory based on profile
      def slurm_profile = workflow.profile.contains('slurm')
      def mem_multiplier = slurm_profile ? 600 : 400
      def mem_max = slurm_profile ? 12000 : 800
      def min_memory = slurm_profile ? 16.GB : 800.MB

      check_max(
        Math.max(min_memory.toGiga().doubleValue(), Math.min((availableMemoryGB * mem_multiplier as Integer), mem_max).doubleValue()).GB * task.attempt,
        'memory'
      )
    }
    time = {
      // Appropriate time for CPU-intensive processes
      def slurm_profile = workflow.profile.contains('slurm')
      def default_time = slurm_profile ? 20.h : 6.h

      check_max(default_time * task.attempt, 'time')
    }
    // Enable multi-threading optimization for all profiles
    beforeScript = {
      // Skip SLURM-specific settings for non-SLURM profiles
      def slurm_profile = workflow.profile.contains('slurm')
      if (slurm_profile) {
        """
        export OMP_NUM_THREADS=8
        export MKL_NUM_THREADS=8
        export SLURM_CPU_BIND=cores
        echo "Process running with 8 threads (SLURM mode)"
        """
      } else {
        """
        export OMP_NUM_THREADS=\$task.cpus
        export MKL_NUM_THREADS=\$task.cpus
        echo "Process running with \$task.cpus threads"
        """
      }
    }
    errorStrategy = 'retry'
    maxRetries = 2  // Increased retries for production
  }

  // For processes that need 2 CPUs (adjusts based on SLURM configuration)
  withLabel: 'cpus_2' {
    cpus = { 
      // First check if we're in SLURM mode
      def slurm_profile = workflow.profile.contains('slurm')
      // If in SLURM mode, use the max_cpus parameter (configurable for different environments)
      def max_cpus = slurm_profile ? Math.min(4, params.max_cpus / 6 as Integer) : 2

      check_max(
        Math.min(max_cpus, Math.max(1, availableCpus as Integer)),
        'cpus'
      ) 
    }

    // Add SLURM-specific cluster options when running with SLURM profile
    clusterOptions = {
      def slurm_profile = workflow.profile.contains('slurm')
      if (slurm_profile) {
        return '--ntasks-per-node=6 --cpus-per-task=2'
      } else {
        return ''
      }
    }

    memory = { 
      // Adjust memory based on profile
      def slurm_profile = workflow.profile.contains('slurm')
      def mem_multiplier = slurm_profile ? 300 : 400
      def mem_max = slurm_profile ? 4000 : 800
      def min_memory = slurm_profile ? 4.GB : 600.MB

      check_max(
        Math.max(min_memory.toGiga().doubleValue(), Math.min((availableMemoryGB * mem_multiplier as Integer), mem_max).doubleValue()).GB * task.attempt,
        'memory'
      )
    }
    time = {
      // Appropriate time for less CPU-intensive processes
      def slurm_profile = workflow.profile.contains('slurm')
      def default_time = slurm_profile ? 12.h : 4.h

      check_max(default_time * task.attempt, 'time')
    }
    // Enable multi-threading optimization for all profiles
    beforeScript = {
      // Skip SLURM-specific settings for non-SLURM profiles
      def slurm_profile = workflow.profile.contains('slurm')
      if (slurm_profile) {
        '''
        export OMP_NUM_THREADS=2
        export MKL_NUM_THREADS=2
        export SLURM_CPU_BIND=cores
        echo "Process running with 2 threads (SLURM mode)"
        '''
      } else {
        '''
        export OMP_NUM_THREADS=2
        export MKL_NUM_THREADS=2
        echo "Process running with 2 threads"
        '''
      }
    }
    errorStrategy = 'retry'
    maxRetries = 2  // Increased retries for production
  }

  // For processes with low resource requirements
  withLabel: 'process_low' {
    cpus = { 
      // First check if we're in SLURM mode
      def slurm_profile = workflow.profile.contains('slurm')
      // If in SLURM mode, use the max_cpus parameter (configurable for different environments)
      def max_cpus = slurm_profile ? Math.min(2, params.max_cpus / 12 as Integer) : 2

      check_max(Math.max(1, Math.min((availableCpus as Integer), max_cpus)) * task.attempt, 'cpus') 
    }

    // Add SLURM-specific cluster options when running with SLURM profile
    clusterOptions = {
      def slurm_profile = workflow.profile.contains('slurm')
      if (slurm_profile) {
        return '--ntasks-per-node=12 --cpus-per-task=1'
      } else {
        return ''
      }
    }

    memory = { 
      // Adjust memory based on profile
      def slurm_profile = workflow.profile.contains('slurm')
      def mem_multiplier = slurm_profile ? 200 : 400
      def mem_max = slurm_profile ? 2000 : 800
      def min_memory = slurm_profile ? 1.GB : 400.MB

      check_max(
        Math.max(min_memory.toGiga().doubleValue(), Math.min((availableMemoryGB * mem_multiplier as Integer), mem_max).doubleValue()).GB * task.attempt,
        'memory'
      )
    }
    time = { 
      // Appropriate time for low resource processes
      def slurm_profile = workflow.profile.contains('slurm')
      def default_time = slurm_profile ? 8.h : 2.h

      check_max(default_time * task.attempt, 'time') 
    }
    // Enable single-threaded optimization for all profiles
    beforeScript = {
      // Skip SLURM-specific settings for non-SLURM profiles
      def slurm_profile = workflow.profile.contains('slurm')
      if (slurm_profile) {
        '''
        export OMP_NUM_THREADS=1
        export MKL_NUM_THREADS=1
        echo "Process running in single-threaded mode (SLURM mode)"
        '''
      } else {
        '''
        export OMP_NUM_THREADS=1
        export MKL_NUM_THREADS=1
        echo "Process running in single-threaded mode"
        '''
      }
    }
    maxRetries = 2  // Increased retries for production
  }

  // For CPU-intensive processes
  withLabel: 'high_cpu' {
    // RECOMMENDED: Use check_max for global constraints
    cpus = { 
      // First check if we're in SLURM mode
      def slurm_profile = workflow.profile.contains('slurm')
      // If in SLURM mode, use the max_cpus parameter (configurable for different environments)
      // Increased CPU allocation for better performance
      def default_cpus = slurm_profile ? Math.max(16, params.max_cpus * 3 / 4 as Integer) : Math.max(12, availableCpus * 3 / 4 as Integer)

      check_max(
        Math.min(
          task.requested_cpus ?: default_cpus, // Default based on profile
          availableCpus
        ),
        'cpus'
      ) 
    }

    // Add SLURM-specific cluster options when running with SLURM profile
    clusterOptions = {
      def slurm_profile = workflow.profile.contains('slurm')
      if (slurm_profile) {
        return "--ntasks-per-node=1 --cpus-per-task=${task.cpus} --hint=nomultithread"
      } else {
        return ''
      }
    }
    memory = { 
      // Adjust memory based on profile too
      def slurm_profile = workflow.profile.contains('slurm')
      def mem_multiplier = slurm_profile ? 900 : 700
      def mem_max = slurm_profile ? 24000 : 8000

      // Increased minimum memory for high_cpu processes
      def min_memory = slurm_profile ? 8.GB : 2.GB

      check_max(
        Math.max(min_memory.toGiga().doubleValue(), Math.min((availableMemoryGB * mem_multiplier as Integer), mem_max).doubleValue()).GB * task.attempt,
        'memory'
      )
    }
    time = {
      // Longer time for high_cpu processes in production
      def slurm_profile = workflow.profile.contains('slurm')
      def default_time = slurm_profile ? 24.h : 8.h

      check_max(default_time * task.attempt, 'time')
    }

    // Enable multi-threading optimization for all profiles
    beforeScript = {
      // Skip SLURM-specific settings for non-SLURM profiles
      def slurm_profile = workflow.profile.contains('slurm')
      if (slurm_profile) {
        """
        export OMP_NUM_THREADS=\$task.cpus
        export MKL_NUM_THREADS=\$task.cpus
        export SLURM_CPU_BIND=cores
        echo "Process running with \$task.cpus threads (high_cpu, SLURM mode)"
        """
      } else {
        """
        export OMP_NUM_THREADS=\$task.cpus
        export MKL_NUM_THREADS=\$task.cpus
        echo "Process running with \$task.cpus threads (high_cpu)"
        """
      }
    }

    // Enable caching for high_cpu processes to avoid redundant computations
    cache = 'deep'
  }

  // For moderately CPU-intensive processes
  withLabel: 'medium_cpu' {
    cpus = { 
      // First check if we're in SLURM mode
      def slurm_profile = workflow.profile.contains('slurm')
      // If in SLURM mode, use the max_cpus parameter (configurable for different environments)
      // Increased CPU allocation for better performance
      def default_cpus = slurm_profile ? Math.max(10, params.max_cpus / 2 as Integer) : Math.max(6, availableCpus / 2 as Integer)

      check_max(
        Math.min(
          task.requested_cpus ?: default_cpus, // Default based on profile
          availableCpus
        ),
        'cpus'
      ) 
    }

    // Add SLURM-specific cluster options when running with SLURM profile
    clusterOptions = {
      def slurm_profile = workflow.profile.contains('slurm')
      if (slurm_profile) {
        return "--ntasks-per-node=2 --cpus-per-task=${task.cpus} --hint=nomultithread"
      } else {
        return ''
      }
    }

    memory = { 
      // Adjust memory based on profile too
      def slurm_profile = workflow.profile.contains('slurm')
      def mem_multiplier = slurm_profile ? 500 : 400
      def mem_max = slurm_profile ? 12000 : 2400

      // Increased minimum memory for medium_cpu processes
      def min_memory = slurm_profile ? 4.GB : 1.5.GB

      check_max(
        Math.max(min_memory.toGiga().doubleValue(), Math.min((availableMemoryGB * mem_multiplier as Integer), mem_max).doubleValue()).GB * task.attempt,
        'memory'
      )
    }
    time = {
      // Appropriate time for medium_cpu processes in production
      def slurm_profile = workflow.profile.contains('slurm')
      def default_time = slurm_profile ? 16.h : 6.h

      check_max(default_time * task.attempt, 'time')
    }

    // Enable multi-threading optimization for all profiles
    beforeScript = {
      // Skip SLURM-specific settings for non-SLURM profiles
      def slurm_profile = workflow.profile.contains('slurm')
      if (slurm_profile) {
        """
        export OMP_NUM_THREADS=\$task.cpus
        export MKL_NUM_THREADS=\$task.cpus
        export SLURM_CPU_BIND=cores
        echo "Process running with \$task.cpus threads (medium_cpu, SLURM mode)"
        """
      } else {
        """
        export OMP_NUM_THREADS=\$task.cpus
        export MKL_NUM_THREADS=\$task.cpus
        echo "Process running with \$task.cpus threads (medium_cpu)"
        """
      }
    }

    // Enable caching for medium_cpu processes
    cache = 'lenient'
  }

  // For processes with minimal resource requirements
  withLabel: 'low_cpu' {
    cpus = { check_max(1, 'cpus') } // Always use 1 CPU

    // Add SLURM-specific cluster options when running with SLURM profile
    clusterOptions = {
      def slurm_profile = workflow.profile.contains('slurm')
      if (slurm_profile) {
        return '--ntasks-per-node=8 --cpus-per-task=1'
      } else {
        return ''
      }
    }

    memory = { 
      // Adjust memory based on profile
      def slurm_profile = workflow.profile.contains('slurm')
      def min_memory = slurm_profile ? 2.GB : 400.MB

      check_max(min_memory * task.attempt, 'memory') 
    }
    time = {
      // Appropriate time for low_cpu processes
      def slurm_profile = workflow.profile.contains('slurm')
      def default_time = slurm_profile ? 8.h : 2.h

      check_max(default_time * task.attempt, 'time')
    }

    // Enable single-threaded optimization for all profiles
    beforeScript = {
      // Skip SLURM-specific settings for non-SLURM profiles
      def slurm_profile = workflow.profile.contains('slurm')
      if (slurm_profile) {
        '''
        export OMP_NUM_THREADS=1
        export MKL_NUM_THREADS=1
        echo "Process running in single-threaded mode (low_cpu, SLURM mode)"
        '''
      } else {
        '''
        export OMP_NUM_THREADS=1
        export MKL_NUM_THREADS=1
        echo "Process running in single-threaded mode (low_cpu)"
        '''
      }
    }
  }
}
